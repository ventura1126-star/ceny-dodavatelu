# ---------------------------------------------------------------------------
# Klíč k Anthropic API — používá se pro čtení položek z PDF faktur.
# Vytvoříte si ho na https://console.anthropic.com/settings/keys
# ---------------------------------------------------------------------------
ANTHROPIC_API_KEY=sk-ant-...

# Model použitý pro čtení dokladů. Ceny orientačně za jeden doklad:
#   claude-opus-5     ~2,20 Kč   nejpřesnější
#   claude-sonnet-5   ~0,90 Kč   rozumný kompromis
#   claude-haiku-4-5  ~0,45 Kč   nejlevnější, na nepřehledných dokladech chybuje víc
ANTHROPIC_MODEL=claude-opus-5

# Jak důkladně má model doklad pročítat: low | medium | high.
# Vyšší hodnota znamená přesnější čtení, ale delší zpracování a vyšší cenu.
ANTHROPIC_EFFORT=medium

# ---------------------------------------------------------------------------
# Databáze.
#   Lokálně:   file:./data/ceny.db          (nic dalšího není potřeba)
#   Produkce:  libsql://<jmeno>-<org>.turso.io   + DATABASE_AUTH_TOKEN
# ---------------------------------------------------------------------------
DATABASE_URL=file:./data/ceny.db
DATABASE_AUTH_TOKEN=
